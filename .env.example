# Phantom-Privacy Slurm / cluster configuration
# Copy this file to .env and fill in the required values before submitting jobs.

# ---------------------------------------------------------------------------
# REQUIRED: Slurm notification email
# ---------------------------------------------------------------------------
# Email address that Slurm will use for job begin/end/fail notifications.
SLURM_MAIL_USER=your.email@example.com

# ---------------------------------------------------------------------------
# REQUIRED: Default Slurm partition
# ---------------------------------------------------------------------------
# Partition used for single-GPU jobs. Multi-GPU presets (e.g. Llama-3-8B) may
# override this via their own SlurmConfig or via the --partition CLI flag.
SLURM_PARTITION=gpu-1xA100

# ---------------------------------------------------------------------------
# OPTIONAL: Slurm account
# ---------------------------------------------------------------------------
# Account / project name to charge the job to. Most clusters in this project
# do not require it. Only set this if your cluster requires #SBATCH --account.
# SLURM_ACCOUNT=your-slurm-account

# ---------------------------------------------------------------------------
# OPTIONAL: Repository location
# ---------------------------------------------------------------------------
# Absolute path to the phantom-privacy repository on the cluster.
PHANTOM_PRIVACY_PROJECT_DIR=$HOME/phantom-privacy

# ---------------------------------------------------------------------------
# OPTIONAL: Scratch root on compute nodes
# ---------------------------------------------------------------------------
# Per-user scratch directory on the cluster compute nodes. Each job creates a
# subdirectory named after its SLURM_JOB_ID under this root. Using local
# scratch reduces NFS traffic and is often required by cluster policy.
PHANTOM_PRIVACY_SCRATCH_ROOT=/scratch/users/$USER

# ---------------------------------------------------------------------------
# OPTIONAL: Singularity image path
# ---------------------------------------------------------------------------
# Path to the Singularity .sif image built by
# scripts/build_singularity_image.sh.
PHANTOM_PRIVACY_SIF_PATH=$PHANTOM_PRIVACY_PROJECT_DIR/images/priv_bench.sif

# ---------------------------------------------------------------------------
# OPTIONAL: Shared base-model cache
# ---------------------------------------------------------------------------
# Large base models (e.g. Llama-3-8B) are copied to this per-node cache before
# training to avoid repeated NFS reads. The directory must be readable/writable
# from the compute nodes.
PHANTOM_PRIVACY_BASE_MODEL_CACHE=$PHANTOM_PRIVACY_SCRATCH_ROOT/base-models

# ---------------------------------------------------------------------------
# OPTIONAL: Slurm log directory
# ---------------------------------------------------------------------------
# Directory where stdout/stderr log files generated by #SBATCH --output and
# --error are written. The launcher will create it if it does not exist.
PHANTOM_PRIVACY_LOG_DIR=$PHANTOM_PRIVACY_PROJECT_DIR/jobs/logs
